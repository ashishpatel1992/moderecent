{
    "name": "ashishpatel/modrecent",
    "type": "phpbb-extension",
    "description": "Admin tool to review the latest topics and posts and clean up spam in bulk: delete topics, posts, all posts by an author, or the author's account.",
    "homepage": "https://ashishpatel.dev",
    "version": "1.0.0",
    "time": "2026-10-19",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Ashish Patel",
            "homepage": "https://ashishpatel.dev",
            "role": "Lead Developer"
        }
    ],
    "require": {
        "php": ">=7.4",
        "composer/installers": "~1.0",
        "phpbb/phpbb": ">=3.3.0,<4.0.0"
    },
    "extra": {
        "display-name": "Moderate Recent",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.0,<4.0.0"
        }
    },
    "keywords": [
        "phpbb",
        "extension",
        "spam",
        "moderation",
        "admin",
        "cleanup"
    ]
}
